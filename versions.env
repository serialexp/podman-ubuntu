# Everything the build fetches, pinned. Each source is a tag and the commit
# it must resolve to; fetch.sh refuses a tag that moved. Toolchains are
# pinned by SHA-256.
#
# REVISION is this repository's packaging revision. Bump it for any change to
# the packages; reset it to 1 when the Podman version changes.

REVISION=2

GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
RUST_VERSION=1.99.1
RUST_SHA256=231fcae47ee950621374725b5fc3b5441d2fbda2955ac45dd7dc816d8876cfe7

PODMAN_VERSION=6.1.4
PODMAN_TAG=v6.1.4
PODMAN_COMMIT=464c15fec06f0074c916f9eff87c4806869c2833

CRUN_VERSION=1.30.1
CRUN_TAG=1.30.1
CRUN_COMMIT=079ff6a7a16d029460af882f9ea44674e6a510b6

CONMON_VERSION=2.2.1
CONMON_TAG=v2.2.1
CONMON_COMMIT=c8cc2c4db27531bd4e084ce7857f73cd21ee639d

# Podman 6 needs netavark and aardvark-dns 2.x.
NETAVARK_VERSION=2.1.0
NETAVARK_TAG=v2.1.0
NETAVARK_COMMIT=8e91ad1d947ed325327b638f0cb906bea1f7d0ab

AARDVARK_DNS_VERSION=2.1.0
AARDVARK_DNS_TAG=v2.1.0
AARDVARK_DNS_COMMIT=cd7417681229219059939bdd9f0b3bd9ac9abb08

# pesto (rootless_port_forwarder = "pasta") needs passt 2026-05-07 or later.
PASST_VERSION=0.0~git20261002.cba3570
PASST_TAG=2026_10_02.cba3570
PASST_COMMIT=cba357068dc586e7540971eb40bb56c5e62c4de1

CATATONIT_VERSION=0.2.1
CATATONIT_TAG=v0.2.1
CATATONIT_COMMIT=bb3b96b99668e544618c5aec427c1f4b6b9ee9bb

# Configuration files, from the container-libs releases Podman builds
# against (go.mod: go.podman.io/common, go.podman.io/image/v5,
# go.podman.io/storage).
COMMON_VERSION=0.69.2
COMMON_TAG=common/v0.69.2
COMMON_COMMIT=3bbb182d1fbf4c2f1566446701421174cbcff580

IMAGE_VERSION=5.41.2
IMAGE_TAG=image/v5.41.2
IMAGE_COMMIT=b5becb3ba69affb5026fbbefe41cb4199a186482

# Podman 6's storage library applies a system storage.conf's graphroot to
# rootless users too, so Ubuntu's (26.04's sets graphroot) must be replaced.
STORAGE_VERSION=1.64.2
STORAGE_TAG=storage/v1.64.2
STORAGE_COMMIT=d6a97a0f44d5bdf94c791ab4685a62b71a1bbbdc

SHORTNAMES_TAG=v2025.03.19
SHORTNAMES_COMMIT=4b8136e465e6b1e866a3cac8fdc3a7ff91d183d8
